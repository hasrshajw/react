# Copy this file to .env.local and fill in your own values. Never commit real values.
# The app runs only against Supabase. On Vercel, set the same variables under
# Project Settings > Environment Variables (enable them for Production), then redeploy.
# api/invite.js (link previews) reads the same two Supabase variables and SITE_URL (below) at runtime.

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://jihtqbzrqymdkypicajz.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7wReBfHAVldVG8Rx9euk9g_PqDL-KfX

# Legacy alternative (only used if the publishable key above is not set):
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Admin email shown in the UI / used as a hint. Real admin access is decided in the database (admins table), not by this value.
VITE_ADMIN_EMAIL=test@gmail.com

# Public address of the site. Used at BUILD time (canonical link, social-preview tags, robots.txt, sitemap.xml) and at runtime by api/invite.js (link-preview pages).
# Example: https://your-domain.com (no path). On Vercel, if this is empty, the project's production domain is used.
SITE_URL=https://react-invitepreview.vercel.app/
# Telugu typing. By default each English word typed in the Telugu fields is sent to Google Input Tools (inputtools.google.com) for the
# Telugu spelling, with offline rules as the fallback. Set to "offline" to send nothing. Needs a rebuild. See README, "Telugu typing".
# VITE_TRANSLITERATION=offline
