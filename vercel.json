{
  "rewrites": [
    {
      "source": "/i/:slug",
      "destination": "/api/invite?slug=:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Googlebot|bingbot|Pinterest|SkypeUriPreview|Applebot).*"
        }
      ]
    },
    {
      "source": "/:slug((?!api$|assets$|i$|login$|invitations$|templates$|create$|inventory$|billing$|customize$|dashboard$|admin$|privacy$|terms$|pricing$|about$|contact$|favicon$|robots$|sitemap$|my$|reviews$)[a-zA-Z0-9_-]+)",
      "destination": "/api/invite?slug=:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Googlebot|bingbot|Pinterest|SkypeUriPreview|Applebot).*"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://inputtools.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}