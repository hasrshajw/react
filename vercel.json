{
  "rewrites": [
    {
      "source": "/i/:slug",
      "destination": "/api/invite?slug=:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Googlebot|bingbot|Pinterest|SkypeUriPreview|Applebot).*"
        }
      ]
    },
    {
      "source": "/:slug((?!api$|assets$|i$|login$|invitations$|templates$|create$|inventory$|billing$|customize$|dashboard$|admin$|privacy$|terms$|pricing$|about$|contact$|favicon$|robots$|sitemap$)[a-zA-Z0-9_-]+)",
      "destination": "/api/invite?slug=:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Googlebot|bingbot|Pinterest|SkypeUriPreview|Applebot).*"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
