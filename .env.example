# Copy this file to .env.local (never commit real values).
# Leave VITE_DATA_SOURCE out (or set to "demo") to run the demo with browser storage only.
VITE_DATA_SOURCE=supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# Legacy alternative (only used if the publishable key above is not set):
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
