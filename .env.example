# Copy this file to .env.local and fill in your own values. Never commit real values.
# The app runs only against Supabase. On Vercel, set the same variables under
# Project Settings > Environment Variables (enable them for Production), then redeploy.
# api/invite.js (link previews) reads the same two Supabase variables and SITE_URL (below) at runtime.

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://jihtqbzrqymdkypicajz.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7wReBfHAVldVG8Rx9euk9g_PqDL-KfX

# Legacy alternative (only used if the publishable key above is not set):
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Admin email shown in the UI / used as a hint. Real admin access is decided in the database (admins table), not by this value.
VITE_ADMIN_EMAIL=test@gmail.com

# Public address of the site. Used at BUILD time (canonical link, social-preview tags, robots.txt, sitemap.xml) and at runtime by api/invite.js (link-preview pages).
# Example: https://your-domain.com (no path). On Vercel, if this is empty, the project's production domain is used.
SITE_URL=

# Telugu typing. By default each English word typed in the Telugu fields is sent to Google Input Tools (inputtools.google.com) for the
# Telugu spelling, with offline rules as the fallback. Set to "offline" to send nothing. Needs a rebuild. See README, "Telugu typing".
# VITE_TRANSLITERATION=offline

# Help links (optional). The "Docs" and "Support" links in the top strip and the "Help center" and "Contact support" items in the profile
# menu use these. Each must be an https address or a mailto: address; if empty, the link is not shown (the menu item reads "Soon").
# VITE_DOCS_URL=https://docs.your-domain.com
# VITE_SUPPORT_URL=mailto:support@your-domain.com

# Preview-picture cleanup (api/cleanup-previews.js). SERVER-SIDE ONLY: set these in Vercel, never with a VITE_ prefix and never in a file in git.
# CRON_SECRET=a-long-random-string
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notify admin on new change_request (api/notify-admin.js). SERVER-SIDE ONLY on Vercel.
# Point a Supabase Database Webhook (INSERT on public.change_requests) at https://your-domain.com/api/notify-admin
# Optional shared secret: set the same value as a header (x-webhook-secret) on the webhook.
# WEBHOOK_SECRET=a-long-random-string
# ADMIN_EMAIL=you@example.com
# RESEND_API_KEY=re_xxxxxxxx          # optional; without it the handler still returns 200 (in-app notification remains)
# FROM_EMAIL=noreply@your-domain.com  # optional; defaults to onboarding@resend.dev style

# Notify client on decision (api/notify-client.js). SERVER-SIDE ONLY on Vercel.
# Point a Supabase Database Webhook (UPDATE on public.change_requests) at https://your-domain.com/api/notify-client
# Same optional WEBHOOK_SECRET / RESEND_API_KEY / FROM_EMAIL / SITE_URL as notify-admin.
# NOTIFY_CLIENT_SECRET=a-long-random-string   # optional alias for WEBHOOK_SECRET
